# CPU-only ComfyUI image for the 4yi App Platform.
# All generation is delegated to 4yi Gateway models via the bundled
# custom_nodes/4yi_gateway pack, so no GPU and no local checkpoints are needed.
FROM python:3.12-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# libX11/libGL are dlopen'd by some stock comfy_extras nodes (e.g. nodes_glsl);
# without them those nodes fail to import (harmless warning, but keeps the boot
# log clean and the nodes available).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libx11-6 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# CPU torch wheels first: the bare "torch" pin in requirements.txt would
# otherwise pull the CUDA-bundled PyPI wheel (~2.5GB of useless nvidia libs).
COPY requirements.txt ./
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

COPY . .
RUN chmod +x /app/entrypoint.4yi.sh

# Persistent state lives on the /data volume; models/ and custom_nodes/ stay
# baked in the image (--base-directory would hide the bundled node pack).
RUN mkdir -p /data/input /data/output /data/temp /data/user

EXPOSE 8188

# Runtime setup (dir seeding, first-run defaults, ComfyUI flags) lives in the
# entrypoint so it runs after the /data volume is mounted. See entrypoint.4yi.sh
# for why each flag is set (cross-site CORS, disable partner API nodes, SQLite
# on the volume, default zh locale, seeded example workflow).
CMD ["/app/entrypoint.4yi.sh"]
